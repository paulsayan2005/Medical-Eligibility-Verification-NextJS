{
  "name": "medical-eligibility-verification",
  "description": "A Midnight dApp for Medical Eligibility Verification using Confidential Credentials (ZK proofs)",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "contract",
    "contract-cli"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "compile": "cd contract/src && rm -rf managed/medical-eligibility-verification && mkdir -p managed/medical-eligibility-verification && ~/.compact/versions/0.31.1/x86_64-unknown-linux-musl/compactc.bin medical-eligibility-verification.compact managed/medical-eligibility-verification && sed -i 's/.*checkRuntimeVersion.*//g' managed/medical-eligibility-verification/contract/index.js && echo '\\u2705 Contract compiled'",
    "test": "npm run test -w contract-cli",
    "cli": "npm run cli -w contract-cli",
    "wallet": "node scripts/generate-key.js",
    "faucet": "node scripts/request-faucet.js",
    "balance": "node scripts/check-balance.js",
    "deploy": "node scripts/deploy.js --new"
  },
  "dependencies": {
    "react": "^18",
    "react-dom": "^18",
    "next": "14.2.33",
    "lucide-react": "^0.370.0",
    "@midnight-ntwrk/compact-runtime": "^0.8.1",
    "@midnight-ntwrk/ledger": "^4.0.0",
    "@midnight-ntwrk/midnight-js-contracts": "2.0.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "2.0.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "2.0.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "2.0.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "2.0.1",
    "@midnight-ntwrk/midnight-js-types": "2.0.1",
    "@midnight-ntwrk/wallet": "5.0.0",
    "@midnight-ntwrk/wallet-api": "5.0.0",
    "@midnight-ntwrk/zswap": "^4.0.0",
    "dotenv": "^16.5.0",
    "node-fetch": "^3.3.2",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.33",
    "@eslint/js": "^9.28.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.1",
    "testcontainers": "^11.0.0",
    "ts-node": "^10.9.2",
    "vitest": "^3.2.0"
  },
  "overrides": {
    "vite": "^8.0.0"
  }
}