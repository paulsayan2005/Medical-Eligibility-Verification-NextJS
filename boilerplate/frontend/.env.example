# Frontend Environment Variables
# These variables configure the network connection for the Midnight dApp frontend.

# For Standalone (local Docker network):
VITE_INDEXER_URL=http://127.0.0.1:8088/api/v1/graphql
VITE_INDEXER_WS_URL=ws://127.0.0.1:8088/api/v1/graphql/ws
VITE_NODE_URL=http://127.0.0.1:9944
VITE_PROOF_SERVER_URL=http://127.0.0.1:6300

# For Preprod Network (when available and synced):
# VITE_INDEXER_URL=https://indexer.preprod.midnight.network/api/v1/graphql
# VITE_INDEXER_WS_URL=wss://indexer.preprod.midnight.network/api/v1/graphql/ws
# VITE_NODE_URL=https://rpc.preprod.midnight.network
# VITE_PROOF_SERVER_URL=http://127.0.0.1:6300 (Proof server still runs locally)
